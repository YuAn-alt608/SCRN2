; ============================================================================
; nvt.mdp — NVT equilibration, 100 ps (2 fs x 50,000 steps), position-restrained
;
; PROVENANCE. Values echoed in nvt.log ("Input Parameters", GROMACS 2022.5).
; Coupling groups Solute / Solvent confirmed from the group names in nvt.tpr.
; gen-vel is not echoed in the log, but GROMACS refuses to integrate a
; continuation=no run without initial velocities, so velocities were generated
; at the coupling temperature (310 K).
; ============================================================================

integrator               = md
dt                       = 0.002
nsteps                   = 50000          ; 100 ps
continuation             = no
gen-vel                  = yes
gen-temp                 = 310

; --- thermostat at 310 K, no barostat ---------------------------------------
tcoupl                   = V-rescale
tc-grps                  = Solute Solvent
tau-t                    = 1.0 1.0
ref-t                    = 310 310
nsttcouple               = 10
pcoupl                   = no
nstpcouple               = -1

; --- neighbour search and non-bonded treatment -------------------------------
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz
verlet-buffer-tolerance  = 0.005
rlist                    = 1.025
coulombtype              = PME
rcoulomb                 = 1.0
fourierspacing           = 0.14
vdwtype                  = cutoff
rvdw                     = 1.0
DispCorr                 = no

; --- constraints --------------------------------------------------------------
constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 4
lincs-iter               = 1

; --- output -------------------------------------------------------------------
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 1000
nstenergy                = 5000

comm-mode                = Linear
nstcomm                  = 100
refcoord-scaling         = no
